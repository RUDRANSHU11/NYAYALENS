# Never upload local secrets or environments.
.env*
.venv/

# Build output and caches - Vercel rebuilds these.
frontend/node_modules/
frontend/.next/
**/__pycache__/
.pytest_cache/
*.tsbuildinfo

# Not needed at runtime (the model also breaks the 500 MB function limit).
.model-cache/
.claude/
tests/
conftest.py
