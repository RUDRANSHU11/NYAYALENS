# Copy to .env and fill in. Never commit the real .env.

# --- LLM (any OpenAI-compatible chat-completions endpoint) ---
# Google Gemini (default), OpenAI, Groq, OpenRouter, Ollama, ... all work here.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT=60

# --- Web ---
# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Limits (privacy + cost + DoS guards) ---
MAX_UPLOAD_MB=10
MAX_PAGES=120
OCR_MAX_PAGES=10
DOC_TTL_MINUTES=30
MAX_DOCS=50
# Hard ceiling for the in-process store, independent of MAX_DOCS.
MAX_MEMORY_MB=256
RATE_LIMIT_PER_MINUTE=30

# --- Scaling (optional) ---
# Set this and documents, caches and rate limits move into Redis, so the API
# can run on several instances. Unset, everything stays in the process.
REDIS_URL=

# --- Retrieval ---
# "fastembed" = local ONNX model (downloads ~130 MB once). "hash" = dependency-free
# lexical fallback, used by the test suite and when fastembed is unavailable.
EMBEDDINGS=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
